# Copy to .env for `npm run dev` (plain Node server). Everything below has a
# safe local default — the API runs with no .env at all.

APP_ENV=development
PORT=8787
SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
# CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=you@example.com
# Cloudflare Pages deploy hook for the admin "Publish site changes" button
# SITE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...

# Error monitoring (optional): Sentry DSN for the API project
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# RELEASE=2026-09-30

# GST tax invoices (required in production for invoices to be issued)
# BUSINESS_LEGAL_NAME=CircuitBay Pvt Ltd
# BUSINESS_GSTIN=32ABCDE1234F1Z5
# BUSINESS_ADDRESS=Registered address
# BUSINESS_STATE_CODE=32

# ---- Database -------------------------------------------------------------
# sqlite  = local file (default, auto-migrated)
# d1-http = Cloudflare D1 via REST API (see README caveats)
DB_DRIVER=sqlite
# SQLITE_PATH=.data/local.sqlite
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=          # token with D1 Edit permission

# ---- File storage -----------------------------------------------------------
# local = .data/uploads (default) | r2 = Cloudflare R2 via S3 API
STORAGE_DRIVER=local
# R2_BUCKET=circuitbay-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://media.circuitbay.in

# ---- Payments -------------------------------------------------------------
# fake = local test flow (signature "fake-ok"); razorpay = real (test keys ok)
PAYMENTS_PROVIDER=fake
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Email / SMS ----------------------------------------------------------
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=      # optional: sync the newsletter list to a Resend audience
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
