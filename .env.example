# Frontend build settings. Copy to .env for local overrides.

# Where the API lives. Leave empty in development (Vite proxies /api and
# /media to http://localhost:8787). For production builds set it to the
# API's public URL, e.g.:
# VITE_API_URL=https://api.circuitbay.in
VITE_API_URL=

# Production builds pull the live catalog (products, articles, projects)
# from this API before prerendering. Leave empty to build from the
# committed seed data in src/content/data/.
# CONTENT_API_URL=https://api.circuitbay.in
CONTENT_API_URL=

# Google Analytics 4 measurement ID (loaded only after cookie consent).
# Empty = analytics off.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for the browser (error monitoring). Empty = off.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
VITE_SENTRY_DSN=
